# ============================================================
# TeamPulse — Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
# NEVER commit the .env file to source control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=task_tracker

# TLS for hosted MySQL providers (TiDB Cloud, PlanetScale, Railway, etc.)
# Set to 'true' to enable TLS with certificate verification.
# Leave unset or set to anything else for local development (no TLS).
DB_SSL=false

# JWT — use a long, random string in production
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173
